<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Calls and texts (always confirmed on screen before they go out). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Finding "Mom" or "Sam" in contacts for calls and texts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Alarms and timers through the clock app's public intents. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Needed to show the system "turn on Bluetooth?" prompt on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The model download runs as a foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Downloading the on-device model (once, by Shuttle itself), checking
         models/manifest.json on GitHub for model updates, and web searches: only the search
         words go to DuckDuckGo and Wikipedia. Everything else is handled on the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Answering "is Wi-Fi on?" and "is mobile data on?". Granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice input. The user's speech recogniser does the recording, but recognisers only
         accept callers that hold this permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Do Not Disturb and silent mode; the user grants it in Settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Brightness and auto-rotate; the user grants "Modify system settings" in Settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- "Open <app>": Android 11+ hides other apps unless we say which ones we look for. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- The user's speech recogniser and text-to-speech engine (Distillery or any other). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shuttle">

        <!-- Setup checklist and a place to try commands. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The assistant panel. Handling ACTION_ASSIST is what makes Shuttle eligible for the
            Assistant role; once chosen, the assist gesture and long-press of the power or home
            button open this activity over whatever app is on screen.
        -->
        <activity
            android:name=".assist.AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.assist"
            android:theme="@style/Theme.Shuttle.Assist"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Downloads the model in the background (llm/ModelDownloadService.kt). -->
        <service
            android:name=".llm.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Optional Quick Settings control: taps tiles that apps can't switch themselves
             (tools/QuickTilesService.kt). Off until the user turns it on in Accessibility. -->
        <service
            android:name=".tools.QuickTilesService"
            android:exported="true"
            android:label="@string/quick_tiles_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/quick_tiles_service" />
        </service>
    </application>
</manifest>
