<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Calls and texts (always confirmed on screen before they go out). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Finding "Mom" or "Sam" in contacts for calls and texts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Alarms and timers through the clock app's public intents. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Needed to show the system "turn on Bluetooth?" prompt on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The model download runs as a foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Downloading the on-device model (once, by Shuttle itself), checking
         models/manifest.json on GitHub for model updates, and web searches: only the search
         words go to DuckDuckGo and Wikipedia. Everything else is handled on the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "What's on my calendar?" (asked for the first time it's needed). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- "Who called?" and "call them back" (asked for the first time it's needed). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- The weather where you are, only when no place is named (asked for when first needed). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Reminders ring on time. Android 12 asks for the first; 13+ grants the second to
         reminder apps. Without either they arrive within a few minutes instead. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Reminders set before a restart are set again after it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Answering "is Wi-Fi on?" and "is mobile data on?". Granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice input. The user's speech recogniser does the recording, but recognisers only
         accept callers that hold this permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Do Not Disturb and silent mode; the user grants it in Settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Brightness and auto-rotate; the user grants "Modify system settings" in Settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- "Open <app>": Android 11+ hides other apps unless we say which ones we look for. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Music players that can play something by name ("play Radiohead"). -->
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <!-- Notes: the apps that can take shared text, to send "add milk to my list" to a notes app. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The user's speech recogniser and text-to-speech engine (Distillery or any other). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shuttle">

        <!-- The full-screen chat. adjustResize: the chat lifts its input above the keyboard
             itself; without it Android also slides the whole window up, pushing the search
             bar off the top and leaving a gap above the keyboard. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share text or a link to Shuttle to summarize, explain or translate it. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            The assistant panel. Handling ACTION_ASSIST is what makes Shuttle eligible for the
            Assistant role; once chosen, the assist gesture and long-press of the power or home
            button open this activity over whatever app is on screen.
        -->
        <activity
            android:name=".assist.AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.assist"
            android:theme="@style/Theme.Shuttle.Assist"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Downloads the model in the background (llm/ModelDownloadService.kt). -->
        <service
            android:name=".llm.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Optional notification access: reading notifications and replying to messages
             (tools/MessagesService.kt). Off until the user turns it on. -->
        <service
            android:name=".tools.MessagesService"
            android:exported="true"
            android:label="@string/messages_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Reminders: shows a reminder when it's due, and sets them again after a restart. -->
        <receiver
            android:name=".tools.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".tools.ReminderRestore"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Optional Quick Settings control: taps tiles that apps can't switch themselves
             (tools/QuickTilesService.kt). Off until the user turns it on in Accessibility. -->
        <service
            android:name=".tools.QuickTilesService"
            android:exported="true"
            android:label="@string/quick_tiles_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/quick_tiles_service" />
        </service>
    </application>
</manifest>
