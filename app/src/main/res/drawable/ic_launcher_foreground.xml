<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon: a weaving shuttle (forked tips, the thread wound in loops inside) lying
  corner to corner, with a thread running through it as a wave, teal to blue. Each outline
  has a wide faint copy underneath for a soft glow. The shuttle stays inside the 66dp safe
  zone; the wave runs off the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The shuttle, drawn level and turned to lie from bottom left to top right. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#3D8BFF"
            android:strokeAlpha="0.2"
            android:strokeWidth="4"
            android:strokeLineJoin="round"
            android:pathData="M31,54 L26,50.2 C38,45.6 70,45.6 82,50.2 L77,54 L82,57.8 C70,62.4 38,62.4 26,57.8 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#4A90FF"
            android:strokeWidth="1.5"
            android:strokeLineJoin="round"
            android:pathData="M31,54 L26,50.2 C38,45.6 70,45.6 82,50.2 L77,54 L82,57.8 C70,62.4 38,62.4 26,57.8 Z" />
        <!-- Thread wound inside: loops getting smaller toward the middle. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#4A90FF"
            android:strokeWidth="1.3"
            android:strokeLineJoin="round"
            android:pathData="M37,54 a17,3.9 0 1,0 34,0 a17,3.9 0 1,0 -34,0" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#4A90FF"
            android:strokeWidth="1.2"
            android:strokeLineJoin="round"
            android:pathData="M43,54 a11,2.3 0 1,0 22,0 a11,2.3 0 1,0 -22,0" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#4A90FF"
            android:strokeWidth="1.1"
            android:strokeLineJoin="round"
            android:pathData="M49,54 a5,0.8 0 1,0 10,0 a5,0.8 0 1,0 -10,0" />
    </group>

    <!-- The thread: one wave through the middle, off both edges. -->
    <path
        android:fillColor="#00000000"
        android:strokeAlpha="0.25"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M8,60 C20,60 24,36 34,36 C46,36 62,72 74,72 C84,72 88,52 100,52">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="54"
                android:endX="100"
                android:endY="54"
                android:startColor="#2EE6B8"
                android:endColor="#3D8BFF" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M8,60 C20,60 24,36 34,36 C46,36 62,72 74,72 C84,72 88,52 100,52">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="54"
                android:endX="100"
                android:endY="54"
                android:startColor="#3CF0C4"
                android:endColor="#4A90FF" />
        </aapt:attr>
    </path>
</vector>
